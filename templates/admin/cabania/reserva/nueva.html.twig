{% extends 'base.html.twig' %}
{% block title %}
    {{title}}
{% endblock %}
{% block stylesheets %}
{% endblock %}
{% block body %}
<main>
    <div class="container-fluid px-4">
        <h1 class="mt-4">Nueva Reserva | {{ cabania.nombre }}</h1>
        <div class="row">
            <div class="col-md-12">
                <div class="card mb-4">
                    <div class="card-header">
                        <i class="fas fa-calendar me-1"></i>
                        Reserva
                    </div>
                    <div class="card-body">
                        <form id="formReserva">
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <div class="form-floating mb-3 mb-md-0">
                                        <input class="form-control" id="fecha_desde" name="fecha_desde" type="date" placeholder="DD-MM-AAAA" />
                                        <label for="fecha_desde">Fecha Desde</label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <input class="form-control" id="fecha_hasta" name="fecha_hasta" type="date" placeholder="DD-MM-AAAA" />
                                        <label for="fecha_hasta">Fecha Hasta</label>
                                    </div>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <div class="form-floating mb-3 mb-md-0">
                                        <input class="form-control" id="nombre" name="nombre" type="text" placeholder="Nombre/s" />
                                        <label for="nombre">Nombre/s</label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <input class="form-control" id="apellido" name="apellido" type="text" placeholder="Apellido/s" />
                                        <label for="apellido">Apellido/s</label>
                                    </div>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <div class="form-floating mb-3 mb-md-0">
                                        <input class="form-control" id="dni" name="dni" type="text" placeholder="12345678" />
                                        <label for="email">D.N.I.</label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <input class="form-control" id="cantidad" name="cantidad" type="number" placeholder="Cantidad de pasajeros"  />
                                        <label for="celular">Pasajeros</label>
                                    </div>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <div class="form-floating mb-3 mb-md-0">
                                        <select class="form-control" id="origen" name="origen">
                                            <option value="" selected disabled>===Seleccione origen de reserva===</option>
                                            <option value="Presencial">Presencial</option>
                                            <option value="Booking">Booking</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <input class="form-control" id="importe" name="importe" type="number" placeholder="Importe a pagar"  />
                                        <label for="importe">Importe</label>
                                    </div>
                                </div>
                                <input type="hidden" name="_id" id="_id" value="{{cabania.id}}" />
                            </div>
                        </form>
                    </div>
                    <div class="card-footer">
                        <div class="row mb-3">
                            <div class="d-grid gap-2 d-md-block">
                                <a href="{{ path('admin_cabania_detalle', {'id': cabania.id}) }}" id="volver" title="Volver" class="btn btn-secondary" >
                                    Volver
                                </a>
                                <buttom type="buttom" id="nuevaReserva" class="btn btn-primary" >
                                    Guardar
                                </buttom>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>
{% endblock %}
{% block javascripts %}
    <script src="{{ asset('js/controller/cabania/reserva/nueva.js') }}"></script>
{% endblock %}