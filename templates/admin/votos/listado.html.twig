{% extends 'base.html.twig' %}

{% block title %}
    {{title}}
{% endblock %}

{% block stylesheets %}
    <style>
        #datatablesSimple td:nth-child(6) {
            min-width: 250px;
        }

        #datatablesSimple .badge {
            font-size: 0.75rem;
            font-weight: 500;
        }

        .filtros-votos {
            background-color: #f8f9fa;
            padding: 15px;
            border-radius: 5px;
            margin-bottom: 20px;
        }

        .total-votos {
            font-weight: bold;
            background-color: #f8f9fa;
        }

        .total-votos td {
            font-weight: bold;
        }
        .datatable-dropdown {
            margin-bottom: 15px;
        }

        .datatable-top {
            padding-bottom: 10px;
        }

        .datatable-bottom {
            padding-top: 15px;
        }
        #tablaResultados {
            margin-top: 10px;
        }

        #tablaResultados th,
        #tablaResultados td {
            vertical-align: middle;
        }

        #tablaResultados td:nth-child(3) {
            text-align: right;
            font-weight: bold;
        }
    </style>
{% endblock %}

{% block body %}
<main>
    <div class="container-fluid px-4">
        <h1 class="mt-4">Listado de votos</h1>
        <br/>

        <div class="row">
            <div class="col-md-12">

                <div class="card mb-4">

                    <div class="card-header">
                        <i class="fas fa-users me-1"></i>
                        Votos
                    </div>

                    <div class="card-body">

                        {# FILTROS #}
                        <div class="filtros-votos">
                            <div class="row">

                                <div class="col-md-2 mb-3">
                                    <label for="filtroLista" class="form-label">
                                        Lista
                                    </label>
                                    <select id="filtroLista" class="form-select">
                                        <option value="">Todas</option>
                                    </select>
                                </div>

                                <div class="col-md-3 mb-3">
                                    <label for="filtroFrente" class="form-label">
                                        Frente
                                    </label>
                                    <select id="filtroFrente" class="form-select">
                                        <option value="">Todos</option>
                                    </select>
                                </div>

                                <div class="col-md-2 mb-3">
                                    <label for="filtroDepartamento" class="form-label">
                                        Departamento
                                    </label>
                                    <select id="filtroDepartamento" class="form-select">
                                        <option value="">Todos</option>
                                    </select>
                                </div>

                                <div class="col-md-3 mb-3">
                                    <label for="filtroMunicipio" class="form-label">
                                        Municipio/Comuna
                                    </label>
                                    <select id="filtroMunicipio" class="form-select">
                                        <option value="">Todos</option>
                                    </select>
                                </div>

                                <div class="col-md-2 mb-3">
                                    <label for="filtroPeriodo" class="form-label">
                                        Periodo
                                    </label>
                                    <select id="filtroPeriodo" class="form-select">
                                        <option value="">Todos</option>
                                    </select>
                                </div>

                            </div>

                            <div class="row">
                                <div class="col-md-12" style="padding-bottom: 20px;">
                                    <button
                                        type="button"
                                        id="btnLimpiarFiltros"
                                        class="btn btn-secondary">
                                        <i class="fas fa-eraser"></i>
                                        Limpiar filtros
                                    </button>
                                </div>
                            </div>
                        </div>

                        {# TABLA #}
                        <table id="datatablesSimple">
                            <thead>
                                <tr>
                                    <th>Lista</th>
                                    <th>Frente</th>
                                    <th>Resultado</th>
                                    <th>Departamento</th>
                                    <th>Municipio/Comuna</th>
                                    <th>Periodo</th>
                                </tr>
                            </thead>

                            <tbody>
                            </tbody>
                        </table>
                        {# TABLA DE RESULTADOS #}
                        <div class="mt-4">

                            <h5>
                                <i class="fas fa-chart-bar me-1"></i>
                                Resultados
                            </h5>

                            <table id="tablaResultados" class="table table-bordered table-striped">
                                <thead>
                                    <tr>
                                        <th>Lista</th>
                                        <th>Frente</th>
                                        <th>Resultado</th>
                                        <th>Periodo</th>
                                    </tr>
                                </thead>

                                <tbody>
                                </tbody>
                            </table>

                        </div>

                    </div>

                    <div class="card-footer">
                        <div class="row mb-3">
                            <div class="d-grid gap-2 d-md-block">
                                <a
                                    href="{{ homeUrl }}"
                                    id="volerPerfil"
                                    title="Volver"
                                    class="btn btn-secondary">
                                    Volver
                                </a>
                            </div>
                        </div>
                    </div>

                </div>

            </div>
        </div>
    </div>
</main>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('node_modules/simple-datatables/dist/umd/simple-datatables.js') }}"></script>

    <script>
        var rutasVoto = {
            listado: "{{ path('admin_votos_listado') }}",
            buscar: "{{ path('admin_ajax_voto_listado') }}",
        };
    </script>

    <script src="{{ asset('js/controller/voto/votos.js') }}"></script>
{% endblock %}