{% extends 'base.html.twig' %}
{% block title %}
    {{title}}
{% endblock %}
{% block stylesheets %}
{% endblock %}
{% block body %}
<main>
    <div class="container-fluid px-4">
        <h1 class="mt-4">Editar Usuario</h1>
        <div class="row">
            <div class="col-md-12">
                <div class="card mb-4">
            <div class="card-header">
                <i class="fas fa-user me-1"></i>
                Usuario
            </div>
            <div class="card-body">
                <svg xmlns="http://www.w3.org/2000/svg" style="display: none;">
                    <symbol id="exclamation-triangle-fill" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
                    </symbol>
                </svg>
                <div class="alert alert-warning d-flex align-items-center" role="alert">
                    <svg class="bi flex-shrink-0 me-2" width="24" height="24" role="img" aria-label="Warning:"><use xlink:href="#exclamation-triangle-fill"/></svg>
                    <div>
                        Si deja vacios los campos de Password y Confirmar Password, no se modificará la misma.
                    </div>
                </div>     
                <form id="formUsuario">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="form-floating mb-3 mb-md-0">
                                <input class="form-control" id="nombre" name="nombre" type="text" placeholder="Nombre/s" value='{{usuario.nombre}}' />
                                <label for="nombre">Nombre/s</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input class="form-control" id="apellido" name="apellido" type="text" placeholder="Apellido/s" value='{{usuario.apellido}}' />
                                <label for="apellido">Apellido/s</label>
                            </div>                                        
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="form-floating mb-3 mb-md-0">
                                <input class="form-control" id="email" name="email" type="email" placeholder="name@example.com" value='{{usuario.email}}' />
                                <label for="email">Correo Electrónico</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input class="form-control" id="celular" name="celular" type="text" placeholder="Sin 0 ni 15"  value='{{usuario.celular}}' />
                                <label for="celular">Celular</label>
                            </div>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="form-floating mb-3 mb-md-0">
                                <select class="form-control" id="rol" name="rol">
                                    {% for rol in roles %}
                                        <option value="{{ rol.id }}" 
                                            {% if rol.id == rolSelected %} selected {% endif %}>
                                                {{ rol.descripcion }}
                                        </option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check mb-3">
                                <input class="form-check-input" id="activo" name="activo" type="checkbox"
                                    {% if usuario.activo is defined %}
                                        {% if usuario.activo == 1 %}
                                            checked
                                        {% endif %}
                                    {% endif %}
                                    value="1"
                                />
                                <label class="form-check-label" for="activo">Activo</label>
                            </div>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="form-floating mb-3 mb-md-0">
                                <input class="form-control" id="password" name="password" type="password" placeholder="Create a password" />
                                <label for="inputPassword">Password</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating mb-3 mb-md-0">
                                <input class="form-control" id="password1" name="password1" type="password" placeholder="Confirm password" />
                                <label for="password1">Confirm Password</label>
                            </div>
                        </div>
                    </div>

                    {% include 'admin/usuarios/_modulos.html.twig' %}
                    <input type="hidden" name="_id" id="_id" value="{{usuario.id}}" />

                </form>
            </div>
            <div class="card-footer">
                <div class="row mb-3">
                    <div class="d-grid gap-2 d-md-block">
                        <a href="{{ path('admin_usuarios_listado') }}" id="volver" title="Volver" class="btn btn-secondary" >
                            Volver
                        </a>
                        <buttom type="buttom" id="updateUsuario" class="btn btn-primary" >
                            Guardar
                        </buttom>
                    </div>
                </div>
            </div>
        </div>
            </div>
        </div>
    </div>
</main>
{% endblock %}
{% block javascripts %}
    <script>
        const usuarioUpdateUrl = "{{ path('admin_ajax_usuario_update') }}";
        const usuariosListadoUrl = "{{ path('admin_usuarios_listado') }}";
    </script>
     <script src="{{ asset('js/controller/usuario/usuarioEditar.js') }}"></script>
{% endblock %}