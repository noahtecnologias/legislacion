{% extends 'base.html.twig' %}

{% block title %}
    {{ title }}
{% endblock %}

{% block body %}
<main>
    <div class="container-fluid px-4">
        <h1 class="mt-4">Nuevo Potencial Base</h1>
        <div class="row">
            <div class="col-md-12">
                <div class="card mb-4">
                    <div class="card-header">
                        <i class="fas fa-plus-circle me-1"></i>
                        Datos del Pozo
                    </div>
                    <div class="card-body">
                        <form id="formPotencial">
                            <div class="row mb-3">
                                <div class="col-md-4">
                                    <div class="form-floating mb-3 mb-md-0">
                                        <input class="form-control" id="pozo" name="pozo" type="number" placeholder="Número de Pozo" required />
                                        <label for="pozo">Número de Pozo</label>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-floating mb-3 mb-md-0">
                                        <input class="form-control" id="potencialNeta" name="potencialNeta" type="number" step="0.001" placeholder="Potencial Neta" required />
                                        <label for="potencialNeta">Potencial Neta</label>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-floating mb-3 mb-md-0">
                                        <select class="form-control" id="tipo" name="tipo" required>
                                            <option value="petróleo">Petróleo</option>
                                            <option value="agua">Agua</option>
                                        </select>
                                        <label for="tipo">Tipo de Fluido</label>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                    <div class="card-footer">
                        <div class="row mb-3">
                            <div class="d-grid gap-2 d-md-block">
                                <a href="{{ path('admin_potenciales_listado') }}" id="volver" title="Volver" class="btn btn-secondary">
                                    Volver
                                </a>
                                <button type="button" id="btnGuardarPotencial" class="btn btn-primary">
                                    Guardar
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>
{% endblock %}

{% block javascripts %}
    <script>
        var baseUrlModulo = "{{ app.request.getSchemeAndHttpHost() }}{{ app.request.getBaseURL() }}/admin/";
    </script>
    <script src="{{ asset('js/controller/potencial/potencialNuevo.js') }}"></script>
{% endblock %}