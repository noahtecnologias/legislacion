{% extends 'base.html.twig' %}

{% block title %}
    {{ title }}
{% endblock %}

{% block body %}
<main>
    <div class="container-fluid px-4">
        <h1 class="mt-4">Listado de Potenciales por Tipo</h1>
        <div class="row mb-3">
            <div class="col-md-12 text-end">
                <a href="{{ path('admin_potencial_nuevo') }}" title="Nuevo Potencial" class="btn btn-primary">Nuevo</a>
            </div>
        </div>

        {# TABLA PETRÓLEO #}
        <div class="card mb-4 border-start border-primary" style="border-width: 5px !important;">
            <div class="card-header bg-light">
                <i class="fas fa-oil-can me-1 text-primary"></i>
                <strong>POTENCIALES: PETRÓLEO</strong>
            </div>
            <div class="card-body">
                <table id="tablaPetroleo" class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Pozo</th>
                            <th>Potencial Neta</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>

        {# TABLA AGUA #}
        <div class="card mb-4 border-start border-info" style="border-width: 5px !important;">
            <div class="card-header bg-light">
                <i class="fas fa-tint me-1 text-info"></i>
                <strong>POTENCIALES: AGUA</strong>
            </div>
            <div class="card-body">
                <table id="tablaAgua" class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Pozo</th>
                            <th>Potencial Agua</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>

        <div class="row mb-5">
            <div class="d-grid gap-2 d-md-block">
                <a href="{{ homeUrl }}" id="volerPerfil" title="Volver" class="btn btn-secondary">
                    Volver
                </a>
            </div>
        </div>
    </div>
</main>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('node_modules/simple-datatables/dist/umd/simple-datatables.js') }}"></script>
    <script>
        var baseUrlModulo = "{{ app.request.getSchemeAndHttpHost() }}{{ app.request.getBaseURL() }}/admin/";
    </script>
    <script src="{{ asset('js/controller/potencial/potenciales.js') }}"></script>
{% endblock %}