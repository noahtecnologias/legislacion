{% extends 'base_login.html.twig' %}

{% block title %}Jujuy Hidrocarburos | Restablecer{% endblock %}

{% block body %}
    <style>
        /* Fondo sólido institucional igual al Login */
        section.bg-institucional {
            background-color: #08261a !important; 
            min-height: 100vh;
            display: flex;
            align-items: center;
        }

        /* Tarjeta personalizada */
        .card-restablecer {
            border: none;
            border-top: 5px solid #0e3c28 !important;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.5) !important;
        }

        /* Botón institucional */
        .btn-verde {
            background-color: #0e3c28 !important;
            border-color: #0e3c28 !important;
            color: #ffffff !important;
            transition: all 0.3s ease;
        }

        .btn-verde:hover {
            background-color: #155d3e !important;
            border-color: #155d3e !important;
        }

        /* Links */
        .link-institucional {
            color: #0e3c28 !important;
            font-weight: 500;
            text-decoration: none;
        }

        .link-institucional:hover {
            color: #155d3e !important;
            text-decoration: underline !important;
        }

        /* Ajuste del footer */
        #layoutAuthentication_footer {
            width: 100%;
            position: absolute;
            bottom: 0;
        }
    </style>

    <section class="bg-institucional">
        <div id="layoutAuthentication" class="w-100">
            <div id="layoutAuthentication_content">
                <main>
                    <div class="container">
                        <div class="row justify-content-center">
                            <div class="col-lg-5">
                                <div class="card card-restablecer rounded-lg mt-5">
                                    <div class="card-header">
                                        <h3 class="text-center font-weight-light my-4">Restablecer contraseña</h3> 
                                    </div>
                                    <div class="card-body">
                                        <div class="small mb-3 text-muted">
                                            Ingrese su correo electrónico y se enviará un email con un link para restablecer su contraseña.
                                        </div>
                                        <form id="formRestablecer">
                                            <div class="form-floating mb-3">
                                                <input class="form-control" id="email" name="email" type="email" placeholder="name@example.com" required />
                                                <label for="email">Correo Electrónico</label>
                                            </div>
                                            <div class="d-flex align-items-center justify-content-between mt-4 mb-0">
                                                <a class="small link-institucional" href="{{ path('app_login') }}">
                                                    Volver al Inicio de Sesión
                                                </a>
                                                <button type="button" id="restablecerPassword" class="btn btn-verde">
                                                    Restablecer contraseña
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </main>
            </div>
            <div id="layoutAuthentication_footer">
                <footer class="py-4 mt-auto">
                    <div class="container-fluid px-4">
                        <div class="d-flex align-items-center justify-content-center small">
                            <div class="text-white-50">
                                Copyright &copy; Jujuy Hidrocarburos <span id="year"></span>
                            </div>
                        </div>
                    </div>
                </footer>
            </div>
        </div>
    </section>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/controller/usuario/restablecerPassword.js') }}"></script>
    <script type="text/javascript">
        $(document).ready(function() {
            $("#year").text(new Date().getFullYear());
        });
    </script>
{% endblock %}