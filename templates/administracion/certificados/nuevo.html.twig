{% extends 'base.html.twig' %}

{% block title %}
    Nuevo Certificado
{% endblock %}

{% block body %}
<main>
    <div class="container-fluid px-4">
        <h1 class="mt-4">Nuevo Certificado</h1>

        <div class="card mb-4">
            <div class="card-header">
                <i class="fas fa-file-alt me-1"></i>
                Certificado
            </div>

            <div class="card-body">
                <form id="formCertificado">

                <div class="row mb-3">
                    <div class="col-md-3">
                        <div class="form-floating">
                            <input class="form-control" id="numero" name="numero" type="number">
                            <label>Certif Nro</label>
                        </div>
                    </div>
                    <div class="col-md-9">
                        <div class="form-floating">
                            <input class="form-control" id="destino" name="destino" type="text">
                            <label>Destino</label>
                        </div>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-3">
                        <div class="form-floating">
                            <input class="form-control" id="fecha" name="fecha" type="date">
                            <label>Fecha</label>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-floating">
                            <input class="form-control" id="metrosCubicos" name="metrosCubicos" type="text">
                            <label>Metros cúbicos</label>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-floating">
                            <input type="text" class="form-control" id="valorBarril" value="{{ configuracion.valorBarril|number_format(4, ',', '.') }}" readonly>
                            <label>Valor Barril</label>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-floating">
                            <input class="form-control" id="cantidadBarriles" name="cantidadBarriles" readonly>
                            <label>Cant. Barriles</label>
                        </div>
                    </div>
                </div>

                <hr>

                <h5>Dólares</h5>
                <div class="row mb-3">
                    <div class="col-md-4">
                        <div class="form-floating">
                            <input class="form-control" id="precioBarrilUsd" name="precioBarrilUsd" type="text">
                            <label>Precio Barril USD</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-floating">
                            <input class="form-control" id="dolarNeto" name="dolarNeto" readonly>
                            <label>Neto USD</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-floating">
                            <input class="form-control" id="dolarIva" name="dolarIva" readonly>
                            <label>IVA USD</label>
                        </div>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-4">
                        <div class="form-floating">
                            <input class="form-control" id="dolarTotal" name="dolarTotal" readonly>
                            <label>Total USD</label>
                        </div>
                    </div>
                </div>

                <hr>

                <h5>Pesos</h5>
                <div class="row mb-3">
                    <div class="col-md-4">
                        <div class="form-floating">
                            <input class="form-control" id="cotizacionUsd" name="cotizacionUsd" type="text">
                            <label>Cotización USD</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-floating">
                            <input class="form-control" id="pesoNeto" name="pesoNeto" readonly>
                            <label>Neto ARS</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-floating">
                            <input class="form-control" id="pesoIva" name="pesoIva" readonly>
                            <label>IVA ARS</label>
                        </div>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-4">
                        <div class="form-floating">
                            <input class="form-control" id="pesoTotal" name="pesoTotal" readonly>
                            <label>Total ARS</label>
                        </div>
                    </div>
                    <div class="col-md-8">
                        <div class="form-floating">
                            <input class="form-control" id="observacion" name="observacion">
                            <label>Observación</label>
                        </div>
                    </div>
                </div>

                </form>
            </div>

            <div class="card-footer">
                <a href="{{ path('administracion_certificados_listado') }}" class="btn btn-secondary">
                    Volver
                </a>

                <button type="button" id="nuevoCertificado" class="btn btn-primary">
                    Guardar
                </button>
            </div>

        </div>

    </div>
</main>
{% endblock %}

{% block javascripts %}
    <script>
        var baseUrlModulo = "{{ app.request.getSchemeAndHttpHost() }}{{ app.request.getBaseURL() }}/administracion/";
    </script>
    <script src="{{ asset('node_modules/decimal.js/decimal.js') }}"></script>
    <script src="{{ asset('js/controller/certificado/nuevo.js') }}"></script>
{% endblock %}