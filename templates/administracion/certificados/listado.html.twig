{% extends 'base.html.twig' %}
{% block title %}
    {{title}}
{% endblock %}
{% block stylesheets %}
    <style>
        #filaTotales {
            font-weight: bold;
            background-color: #f8f9fa;
        }

        #filaTotales th {
            border-top: 2px solid #000;
        }
        #datatablesSimple thead th {
            text-align: center;
            vertical-align: middle;
            font-weight: bold;
        }

        #datatablesSimple tfoot th {
            font-weight: bold;
            background: #f5f5f5;
            border-top: 2px solid #000;
        }

        #datatablesSimple td {
            text-align: right;
        }

        #datatablesSimple td:nth-child(1),
        #datatablesSimple td:nth-child(2),
        #datatablesSimple td:nth-child(3) {
            text-align: left;
        }
    </style>
{% endblock %}
{% block body %}
<main>
    <div class="container-fluid px-4">
        <h1 class="mt-4">Listado de certificados</h1>
        <br/>
        {# Filtros #}
        <div class="card mb-4">
            <div class="card-header">
                <i class="fas fa-filter me-1"></i>
                Filtros de búsqueda
            </div>

            <div class="card-body">
                <form id="formBusquedaCertificados">

                    <div class="row align-items-end">

                        <div class="col-md-3">
                            <label for="mes" class="form-label">Mes</label>
                            <select class="form-control" id="mes" name="mes">
                                <option value="">Todos</option>
                                <option value="1">Enero</option>
                                <option value="2">Febrero</option>
                                <option value="3">Marzo</option>
                                <option value="4">Abril</option>
                                <option value="5">Mayo</option>
                                <option value="6">Junio</option>
                                <option value="7">Julio</option>
                                <option value="8">Agosto</option>
                                <option value="9">Septiembre</option>
                                <option value="10">Octubre</option>
                                <option value="11">Noviembre</option>
                                <option value="12">Diciembre</option>
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label for="anio" class="form-label">Año</label>
                            <select class="form-control" id="anio" name="anio">

                                {% set anioActual = "now"|date("Y") %}

                                {% for anio in range(anioActual, anioActual - 10) %}
                                    <option
                                        value="{{ anio }}"
                                        {% if anio == anioActual %}selected{% endif %}
                                    >
                                        {{ anio }}
                                    </option>
                                {% endfor %}

                            </select>
                        </div>

                        <div class="col-md-6 text-end">

                            <button
                                type="button"
                                class="btn btn-primary"
                                id="buscarCertificados"
                            >
                                <i class="fas fa-search"></i>
                                Buscar
                            </button>

                            <button
                                type="button"
                                class="btn btn-secondary"
                                id="limpiarFiltros"
                            >
                                <i class="fas fa-eraser"></i>
                                Limpiar
                            </button>
                            <button
                                type="button"
                                class="btn btn-success"
                                id="exportarExcel"
                            >
                                <i class="fas fa-file-excel"></i>
                                Exportar
                            </button>
                        </div>

                    </div>

                </form>
            </div>
        </div>
       
        <div class="row">
            <div class="col-md-12 text-end">
                <a href="{{ path('administracion_certificado_nuevo') }}" title="Nuevo Certificado" class="btn btn-primary">Nuevo</a>
            </div>
        </div>
        <br/>
        <div class="row">
            <div class="col-md-12">
                <div class="card mb-4">
            <div class="card-header">
                <i class="fas fa-certificate me-1"></i>
                Certificados
            </div>
            <div class="card-body">
                <table id="datatablesSimple">
                    <thead>
                        <tr>
                            <th>Certif Nro</th>
                            <th>Destino</th>
                            <th>Fecha</th>

                            <th>Metros Cúbicos</th>
                            <th>Cant. Barriles</th>

                            <th>Precio Barril U$D</th>

                            <th>USD P.Neto</th>
                            <th>USD IVA</th>
                            <th>USD P.Total</th>

                            <th>Cotiz U$D Divisa</th>

                            <th>$ P.Neto</th>
                            <th>$ IVA</th>
                            <th>$ P.Total</th>

                            <th>Observaciones</th>

                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                    <tfoot>
                        <tr id="filaTotales">
                            <th colspan="3">TOTALES</th>

                            <th></th>
                            <th></th>
                            <th></th>

                            <th></th>
                            <th></th>
                            <th></th>

                            <th></th>

                            <th></th>
                            <th></th>
                            <th></th>

                            <th></th>
                            <th></th>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <div class="card-footer">
                <div class="row mb-3">
                    <div class="d-grid gap-2 d-md-block">
                        <a href="{{ homeUrl }}" id="volerPerfil" title="Volver" class="btn btn-secondary" >
                            Volver
                        </a>
                    </div>
                </div>
            </div>
        </div>
            </div>
        </div>
    </div>
</main>
{% endblock %}
{% block javascripts %}
    <script src="{{ asset('node_modules/simple-datatables/dist/umd/simple-datatables.js') }}"></script>
    <script>
        var baseUrlModulo = "{{ app.request.getSchemeAndHttpHost() }}{{ app.request.getBaseURL() }}/administracion/";
    </script>
    <script src="{{ asset('js/controller/certificado/listado.js') }}"></script>
{% endblock %}