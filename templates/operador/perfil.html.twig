{% extends 'base.html.twig' %}
{% block title %}
    {{title}}
{% endblock %}
{% block stylesheets %}
{% endblock %}
{% block body %}
    <main>
        <div class="container-fluid px-4">
            <h1 class="mt-4">Perfil Usuario</h1>
            <div class="row">
                <div class="col-lg-12">
                    <div class="card mb-4">
                        <div class="card-header">
                            <h3 class="text-center font-weight-light my-4">Perfil</h3>
                        </div>
                        <div class="card-body">
                            <svg xmlns="http://www.w3.org/2000/svg" style="display: none;">
                                <symbol id="exclamation-triangle-fill" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
                                </symbol>
                            </svg>
                            <div class="alert alert-warning d-flex align-items-center" role="alert">
                                <svg class="bi flex-shrink-0 me-2" width="24" height="24" role="img" aria-label="Warning:"><use xlink:href="#exclamation-triangle-fill"/></svg>
                                <div>
                                    Si deja vacios los campos de Password y Confirmar Password, no se modificará la misma.
                                </div>
                            </div>
                            <form id="formPerfil" action="{{ path('operador_ajax_perfil_update') }}" method="PUT">
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <div class="form-floating mb-3 mb-md-0">
                                            <input class="form-control" id="nombre" name="nombre" type="text" placeholder="Nombre/s" value='{{ data.nombre }}' />
                                            <label for="nombre">Nombre/s</label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-floating">
                                            <input class="form-control" id="apellido" name="apellido" type="text" placeholder="Apellido/s" value='{{ data.apellido }}' />
                                            <label for="apellido">Apellido/s</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <div class="form-floating mb-3 mb-md-0">
                                            <input class="form-control" id="email" name="email" type="email" placeholder="name@example.com" value='{{ data.email }}' />
                                            <label for="email">Correo Electrónico</label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-floating">
                                            <input class="form-control" id="celular" name="celular" type="text" placeholder="Sin 0 ni 15" value='{{ data.celular }}' />
                                            <label for="celular">Celular</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <div class="form-floating mb-3 mb-md-0">
                                            <input class="form-control" id="rol_descripcion" type="text" name="rol_descripcion" placeholder="Rol" value='{{ roles[1].descripcion }}' readonly />
                                            <label for="rol">Rol</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="row mb-4">
                                    <div class="col-md-12">
                                        <div class="card border-0 bg-light">
                                            <div class="card-header bg-transparent">
                                                <div class="d-flex align-items-center">
                                                    <i class="fas fa-th-large me-2"></i>
                                                    <strong>Módulos habilitados</strong>
                                                </div>
                                                <small class="text-muted">
                                                    Módulos a los que tiene acceso este usuario.
                                                </small>
                                            </div>

                                            <div class="card-body">
                                                <div class="row">
                                                    {% for modulo in data.modulos %}
                                                        <div class="col-md-4 col-lg-3 mb-2">
                                                            <div class="form-check">
                                                                <input
                                                                    class="form-check-input modulo-perfil"
                                                                    type="checkbox"
                                                                    name="modulos[]"
                                                                    value="{{ modulo.id }}"
                                                                    id="modulo_{{ modulo.id }}"
                                                                    checked
                                                                    onclick="return false;"
                                                                >

                                                                <label
                                                                    class="form-check-label"
                                                                    for="modulo_{{ modulo.id }}"
                                                                >
                                                                    {{ modulo.nombre }}
                                                                </label>
                                                            </div>
                                                        </div>
                                                    {% endfor %}
                                                </div>

                                                {% if data.modulos is empty %}
                                                    <div class="alert alert-warning mb-0">
                                                        <i class="fas fa-exclamation-triangle me-2"></i>
                                                        Este usuario no tiene módulos asignados.
                                                    </div>
                                                {% endif %}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <div class="form-floating mb-3 mb-md-0">
                                            <input class="form-control" id="password" name="password" type="password" placeholder="Create a password" />
                                            <label for="inputPassword">Password</label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-floating mb-3 mb-md-0">
                                            <input class="form-control" id="password1" name="password1" type="password" placeholder="Confirm password" />
                                            <label for="inputPasswordConfirm">Confirm Password</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="d-grid gap-2 d-md-block">
                                        <a href="{{ path('operador_home') }}" id="volerPerfil" title="Volver" class="btn btn-secondary" >
                                            Volver
                                        </a>
                                        <buttom type="buttom" id="updatePerfil" class="btn btn-primary" >
                                            Guardar
                                        </buttom>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/controller/usuario/perfil.js') }}"></script>
{% endblock %}