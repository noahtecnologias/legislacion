{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
<main>
    <div class="container-fluid px-4">
        <h1 class="mt-4">Nueva Carga Diaria</h1>
        <div class="card mb-4">
            <form id="formProduccion">
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-3">
                            <div class="form-floating"><input class="form-control" name="fecha" type="text" value="{{ "now"|date("d/m/Y") }}" /><label>Fecha</label></div>
                        </div>
                    </div>

                    <h6 class="text-primary">Sección Gas</h6><hr>
                    <div class="row mb-3">
                        <div class="col-md-3"><div class="form-floating"><input class="form-control" name="gas_producido" type="text" /><label>Gas Producido</label></div></div>
                        <div class="col-md-3"><div class="form-floating"><input class="form-control" name="gas_venteado" type="text" /><label>Gas Venteado</label></div></div>
                        <div class="col-md-3"><div class="form-floating"><input class="form-control" name="gas_inyectado" type="text" /><label>Gas Inyectado</label></div></div>
                        <div class="col-md-3"><div class="form-floating"><input class="form-control" name="gas_9300_kcal" type="text" /><label>Gas a 9300 Kcal</label></div></div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-3"><div class="form-floating"><input class="form-control" name="poder_calorifico" type="text" /><label>Poder Calorífico</label></div></div>
                        <div class="col-md-3"><div class="form-floating"><input class="form-control" name="gas_combustible" type="text" /><label>Gas Combustible</label></div></div>
                        <div class="col-md-3"><div class="form-floating"><input class="form-control" name="gas_convertido" type="text" /><label>Gas Convertido</label></div></div>
                        <div class="col-md-3"><div class="form-floating"><input class="form-control" name="propano" type="text" /><label>Propano</label></div></div>
                    </div>

                    <h6 class="text-primary">Petróleo y Agua</h6><hr>
                    <div class="row mb-3">
                        <div class="col-md-3"><div class="form-floating"><input class="form-control" name="bruta" type="text" /><label>Bruta</label></div></div>
                        <div class="col-md-3"><div class="form-floating"><input class="form-control" name="neta" type="text" /><label>Neta</label></div></div>
                        <div class="col-md-3"><div class="form-floating"><input class="form-control" name="agua_producida" type="text" /><label>Agua Producida</label></div></div>
                        <div class="col-md-3"><div class="form-floating"><input class="form-control" name="agua_inyectada" type="text" /><label>Agua Inyectada</label></div></div>
                        <div class="col-md-3"><div class="form-floating"><input class="form-control" name="petroleo_despachado" type="text" /><label>Petróleo Despachado</label></div></div>
                    </div>

                    <h6 class="text-danger">Control de Campo</h6><hr>
                    <div class="row mb-3">
                        <div class="col-md-3"><div class="form-floating"><input class="form-control" name="stock_actual" type="text" /><label>Stock Actual</label></div></div>
                        <div class="col-md-3"><div class="form-floating"><input class="form-control" name="lluvia_caida" type="text" /><label>LLUVIA CAIDA</label></div></div>
                        <div class="col-md-3"><div class="form-floating"><input class="form-control" name="horas_generador" type="text" /><label>Horas E/scio Gen.</label></div></div>
                        <div class="col-md-3"><div class="form-floating"><input class="form-control" name="horas_lts" type="text" /><label>Horas E/scio L.T.S.</label></div></div>
                    </div>
                </div>
                <div class="card-footer text-end">
                    <button type="button" id="guardarProduccion" class="btn btn-primary">Guardar Producción</button>
                </div>
            </form>
        </div>
    </div>
</main>
{% endblock %}
{% block javascripts %}
    {{ parent() }} {# Importante para no pisar los scripts base #}
    <script>
        var baseUrlModulo = "{{ app.request.getSchemeAndHttpHost() }}{{ app.request.getBaseURL() }}/operador/";
    </script>
    <script src="{{ asset('js/controller/produccion/produccionNuevo.js') }}"></script>
{% endblock %}