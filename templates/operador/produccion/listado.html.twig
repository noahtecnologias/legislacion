{% extends 'base.html.twig' %}
{% block title %}{{title}}{% endblock %}
{% block stylesheets %}
    {{ parent() }}
    <style>
        /* Quitamos el límite de altura al cuerpo de la tabla y al card */
        .datatable-container {
            overflow-x: auto !important; /* Mantiene scroll horizontal si es muy ancha */
            overflow-y: visible !important; /* Elimina el scroll vertical */
            max-height: none !important;
        }
        
        .card-body {
            overflow: visible !important;
        }
    </style>
{% endblock %}

{% block body %}
<main>
    <div class="container-fluid px-4">
        <h1 class="mt-4">Producción Diaria</h1>
        <div class="row">
            <div class="col-md-12 text-end">
                <a href="{{ path('operador_produccion_nuevo') }}" class="btn btn-primary">Nuevo Registro</a>
            </div>
        </div>
        <br/>
        <div class="card mb-4">
            <div class="card-header"><i class="fas fa-table me-1"></i> Histórico</div>
            <div class="card-body">
                <table id="datatablesSimple">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Gas Producido</th>
                            <th>Bruta</th>
                            <th>Neta</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</main>
{% endblock %}
{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="{{ asset('node_modules/simple-datatables/dist/umd/simple-datatables.js') }}"></script>
    <script>
        var baseUrlModulo = "{{ app.request.getSchemeAndHttpHost() }}{{ app.request.getBaseURL() }}/operador/";
    </script>
    <script src="{{ asset('js/controller/produccion/produccion.js') }}"></script>
{% endblock %}