{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
<main>
    <div class="container-fluid px-4">
        <h1 class="mt-4">Historial de Partes Diarios</h1>
        
        <div class="card mb-4 mt-3">
            <div class="card-header bg-dark text-white">
                <i class="fas fa-history me-1"></i>
                Fechas Consolidadas
            </div>
            <div class="card-body">
                <table class="table table-bordered table-striped table-hover" id="tablaHistorial">
                    <thead class="table-secondary">
                        <tr>
                            <th>Fecha del Parte</th>
                            <th class="text-end">Prod. Real Total Vol (m³/día)</th>
                            <th class="text-end">Pérdida Total Vol (m³/día)</th>
                            <th class="text-center" width="15%">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in historial %}
                            <tr>
                                <td class="fw-bold font-monospace">{{ item.fecha }}</td>
                                <td class="text-end font-monospace text-success fw-bold">{{ item.totalReal|number_format(2, '.', ',') }}</td>
                                <td class="text-end font-monospace text-danger">{{ item.totalPerdida|number_format(2, '.', ',') }}</td>
                                <td class="text-center">
                                    <a href="{{ path('operador_potencial_diario_detalle', {'fecha': item.fecha|date('Y-m-d')}) }}" class="btn btn-primary btn-sm">
                                        <i class="fas fa-eye me-1"></i> Ver Detalle
                                    </a>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="4" class="text-center text-muted">No hay partes diarios cargados en el sistema todavía.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</main>
{% endblock %}