{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
<main>
    <div class="container-fluid px-4">
        <h1 class="mt-4">Control de Potenciales Diario</h1>
        
        <div class="card mb-4">
            <div class="card-body bg-light">
                <div class="row align-items-center">
                    <div class="col-md-3">
                        <label for="fechaParte" class="form-label"><strong>Fecha del Parte:</strong></label>
                        <input type="date" id="fechaParte" class="form-control" value="{{ fechaHoy }}">
                    </div>
                    <div class="col-md-9 text-end mt-4">
                        <button type="button" id="btnGuardarDia" class="btn btn-success btn-lg">
                            <i class="fas fa-save me-1"></i> Guardar Día Global
                        </button>
                    </div>
                </div>
            </div>
        </div>

        {# TABLA PETRÓLEO #}
        <div class="card mb-4 border-start border-primary" style="border-width: 5px !important;">
            <div class="card-header bg-light">
                <i class="fas fa-oil-can me-1 text-primary"></i>
                <strong>POTENCIALES DIARIOS: PETRÓLEO</strong>
            </div>
            <div class="card-body">
                <table class="table table-bordered table-hover" id="tabla-petroleo">
                    <thead class="table-dark">
                        <tr>
                            <th width="8%">Pozo</th>
                            <th width="12%">Potencial Neta</th>
                            <th width="10%">%</th>
                            <th width="12%">Valor Control</th>
                            <th width="10%">% Control</th>
                            <th width="12%">Downtime (hs)</th>
                            <th width="12%">Real</th>
                            <th width="12%">Pérdida</th>
                            <th width="12%">Diferc/hs</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                    <tfoot class="table-secondary font-weight-bold"></tfoot>
                </table>
            </div>
        </div>

        {# TABLA AGUA #}
        <div class="card mb-4 border-start border-info" style="border-width: 5px !important;">
            <div class="card-header bg-light">
                <i class="fas fa-tint me-1 text-info"></i>
                <strong>POTENCIALES DIARIOS: AGUA</strong>
            </div>
            <div class="card-body">
                <table class="table table-bordered table-hover" id="tabla-agua">
                    <thead class="table-dark">
                        <tr>
                            <th width="8%">Pozo</th>
                            <th width="12%">Potencial Neta</th>
                            <th width="10%">%</th>
                            <th width="12%">Valor Control</th>
                            <th width="10%">% Control</th>
                            <th width="12%">Downtime (hs)</th>
                            <th width="12%">Real</th>
                            <th width="12%">Pérdida</th>
                            <th width="12%">Diferc/hs</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                    <tfoot class="table-secondary font-weight-bold"></tfoot>
                </table>
            </div>
        </div>

        {# TABLA GAS (Dependiente de Petróleo y GOR) #}
        <div class="card mb-4 border-start border-warning" style="border-width: 5px !important;">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <div>
                    <i class="fas fa-fire me-1 text-warning"></i>
                    <strong>POTENCIALES DIARIOS: GAS</strong>
                </div>
            </div>
            <div class="card-body">
                <table class="table table-bordered table-hover" id="tabla-gas">
                    <thead class="table-dark">
                        <tr>
                            <th width="12%">Pozo</th>
                            <th width="18%">GOR</th>
                            <th width="25%">Potencial Gas Mm3/día</th>
                            <th width="20%">Downtime</th>
                            <th width="25%">Total Gas</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                    <tfoot class="table-secondary font-weight-bold"></tfoot>
                </table>
            </div>
        </div>

    </div>
</main>
{% endblock %}

{% block javascripts %}
    <script>
        const potencialesBaseAdmin = {{ potencialesJson|raw }};
    </script>
    <script src="{{ asset('js/controller/potencial/carga_diaria.js') }}"></script>
{% endblock %}