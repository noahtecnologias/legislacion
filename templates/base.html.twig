<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}{% endblock %}</title>
        
        {# Estilos del tema #}
        <link rel="stylesheet" href="{{ asset('node_modules/simple-datatables/dist/style.css') }}">
        <link rel="stylesheet" href="{{ asset('node_modules/bootstrap/dist/css/bootstrap.min.css') }}">
        <link rel="stylesheet" href="{{ asset('node_modules/sweetalert/dist/sweetalert.css') }}">
        <link rel="stylesheet" href="{{ asset('css/styles.css') }}">
        <link rel="stylesheet" href="{{ asset('css/estilos.css') }}">
    </head>
    
    {% include 'config.html.twig' %}
    <body class="sb-nav-fixed loadFones">
        {# Navbar, Sidebar, etc., según el diseño del tema SB Admin #}
        <div id="layoutSidenav">
            {% if app.user %}
                {% include 'nav.html.twig' %}
                {% include 'nav-menu.html.twig' %}
            {% endif %}
            <div id="layoutSidenav_content">
                {% block body %}
                {% endblock %}
                <footer class="py-4 bg-light mt-auto">
                    <div class="container-fluid px-4">
                        <div class="d-flex align-items-center justify-content-between small">
                            <div class="text-muted">Copyright &copy; Legislación <b id="year"></b></div>
                        </div>
                    </div>
                </footer>
            </div>
        </div>
        {# Scripts del tema #}
        <script src="{{ asset('node_modules/jquery/dist/jquery.min.js') }}"></script>
        <script src="{{ asset('node_modules/bootstrap/dist/js/bootstrap.bundle.min.js') }}"></script>
        <script src="{{ asset('js/scripts.js') }}"></script>
        <script src="{{ asset('node_modules/sweetalert/dist/sweetalert.min.js') }}"></script>
        <script src="{{ asset('node_modules/jquery-validation/dist/jquery.validate.min.js') }}"></script>
        <script src="{{ asset('node_modules/@fortawesome/fontawesome-free/js/all.min.js') }}"></script>
        <script src="{{ asset('node_modules/fullcalendar/index.global.min.js') }}"></script>
        <script type="text/javascript">
            $(document).ready(function() {
                var fullyear = new Date();
                var year = fullyear.getFullYear();
                $("#year").text(year);
            });
            </script>
        {% block javascripts %}{% endblock %}
    </body>
</html>
